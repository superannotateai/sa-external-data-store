{
    "name": "sa-external-data-store",
    "version": "1.0.0",
    "description": "A Node.js/Express API service for managing data streams with AWS S3 storage backend, integrated with SuperAnnotate authentication",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "nodemon src/index.ts",
        "watch": "tsc --watch",
        "clean": "rm -rf dist",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "keywords": [
        "superannotate",
        "s3",
        "data-store",
        "stream",
        "express",
        "typescript",
        "aws"
    ],
    "author": "",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": ""
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "3.978.0",
        "@aws-sdk/lib-storage": "3.978.0",
        "@aws-sdk/s3-request-presigner": "3.978.0",
        "chalk": "5.6.2",
        "cors": "2.8.6",
        "dotenv": "17.2.3",
        "express": "^4.18.2",
        "mime-types": "3.0.2"
    },
    "devDependencies": {
        "@types/cors": "2.8.19",
        "@types/express": "^4.17.21",
        "@types/jest": "30.0.0",
        "@types/mime-types": "3.0.1",
        "@types/node": "^20.10.0",
        "jest": "30.2.0",
        "nodemon": "3.1.11",
        "ts-jest": "29.4.6",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    }
}
